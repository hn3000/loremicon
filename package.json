{
  "name": "loremicon",
  "version": "0.10.1",
  "description": "",
  "repository": {
    "url": "https://github.com/hn3000/loremicon",
    "type": "git"
  },
  "main": "index.js",
  "type": "module",
  "scripts": {
    "prestart": "tsc -p tsconfig.json",
    "start": "node out/index",
    "tsc": "tsc -p tsconfig.json",
    "prebuild": "tsc -p tsconfig.json",
    "build": "webpack -c webpack.config.js",
    "webpack": "webpack-dev-server -c webpack.dev.js",
    "docker": "docker build . -t loremicon",
    "docker:node-latest": "docker build . -f dockerfile.latest -t loremicon:node-latest",
    "predocker-run": "npm run test",
    "docker-run": "docker-compose up -d --build",
    "pretest": "tsc -p tsconfig.test.json",
    "test": "node out-test/test/all-tests",
    "precover": "tsc -p tsconfig.test.json",
    "cover": "c8 node out-test/test/all-tests.js"
  },
  "keywords": [
    "lorem image",
    "lorem icon",
    "loremicon",
    "http",
    "rest",
    "api"
  ],
  "author": "Harald Niesche",
  "license": "MIT",
  "dependencies": {
    "canvas": "^3.2.0",
    "express": "^5.1.0",
    "full-icu": "^1.5.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.5",
    "@types/node": "^24.10.0",
    "clean-webpack-plugin": "^4.0.0",
    "html-webpack-plugin": "^5.6.4",
    "c8": "^10.1.3",
    "ts-loader": "^9.5.4",
    "@hn3000/tsunit-async": "^2.0.0",
    "typescript": "^5.9.3",
    "webpack": "^5.102.1",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.2"
  },
  "c8": {
    "include": [
      "out-test/src/**",
      "src/*.ts"
    ],
    "reporter": [
      "text",
      "html",
      "lcov"
    ]
  }
}
